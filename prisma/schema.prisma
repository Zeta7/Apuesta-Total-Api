generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum EventStatus {
  SCHEDULED
  LIVE
  FINISHED
  POSTPONED
  CANCELLED
  SUSPENDED
}

enum DurationSource {
  SOURCE
  ESTIMATED
  UNKNOWN
}

enum GroupSource {
  VERIFIED_FIXTURE
  DATASET_FALLBACK
}

enum BetStatus {
  PENDING
  ACCEPTED
  REJECTED
  CANCELLED
  SETTLED
  WON
  LOST
  VOID
}

enum BetType {
  SINGLE
  COMBO
}

enum MovementType {
  DEBIT
  CREDIT
}

enum OutboxStatus {
  PENDING
  PROCESSING
  PUBLISHED
  FAILED
}

model Competition {
  id         String   @id @default(uuid()) @db.Uuid
  externalId String   @unique
  name       String
  events     Event[]
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model Phase {
  id        String   @id @default(uuid()) @db.Uuid
  code      String   @unique
  name      String
  order     Int
  events    Event[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model TournamentGroup {
  id        String   @id @default(uuid()) @db.Uuid
  code      String   @unique
  name      String
  order     Int
  events    Event[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Team {
  id             String   @id @default(uuid()) @db.Uuid
  externalId     String   @unique
  name           String
  shortName      String?
  countryCode    String?
  fifaCode       String?
  flagUrl        String?
  sourceCountry  String?
  sourceMetadata Json?
  homeEvents     Event[]  @relation("HomeTeam")
  awayEvents     Event[]  @relation("AwayTeam")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model Event {
  id                 String           @id @default(uuid()) @db.Uuid
  externalId         String           @unique
  name               String
  startDate          DateTime
  endDate            DateTime?
  estimatedEndDate   DateTime?
  durationSource     DurationSource
  externalLeagueId   String
  externalStatus     String?
  status             EventStatus
  isLive             Boolean
  isSuspended        Boolean
  earlyPayoutEnabled Boolean
  statisticsEnabled  Boolean
  betBuilderEnabled  Boolean
  superOddsEnabled   Boolean          @default(false)
  livePeriod         String?
  liveClockSeconds   Int?
  clockRunning       Boolean          @default(false)
  homeScore          Int?
  awayScore          Int?
  homePlaceholder    String?
  awayPlaceholder    String?
  groupSource        GroupSource
  sourceMetadata     Json?
  competitionId      String           @db.Uuid
  phaseId            String           @db.Uuid
  groupId            String?          @db.Uuid
  homeTeamId         String?          @db.Uuid
  awayTeamId         String?          @db.Uuid
  competition        Competition      @relation(fields: [competitionId], references: [id])
  phase              Phase            @relation(fields: [phaseId], references: [id])
  group              TournamentGroup? @relation(fields: [groupId], references: [id])
  homeTeam           Team?            @relation("HomeTeam", fields: [homeTeamId], references: [id])
  awayTeam           Team?            @relation("AwayTeam", fields: [awayTeamId], references: [id])
  markets            Market[]
  betSelections      BetSelection[]
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  @@index([startDate, id])
  @@index([phaseId, groupId])
}

model MarketType {
  id           String   @id @default(uuid()) @db.Uuid
  externalId   String   @unique
  name         String
  displayOrder Int
  metadata     Json?
  markets      Market[]
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Market {
  id             String      @id @default(uuid()) @db.Uuid
  externalId     String      @unique
  name           String
  isSuspended    Boolean
  isLive         Boolean
  status         String?
  sourceMetadata Json?
  eventId        String      @db.Uuid
  marketTypeId   String      @db.Uuid
  event          Event       @relation(fields: [eventId], references: [id], onDelete: Cascade)
  marketType     MarketType  @relation(fields: [marketTypeId], references: [id])
  selections     Selection[]
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  @@index([eventId, marketTypeId])
}

model Selection {
  id             String         @id @default(uuid()) @db.Uuid
  externalId     String         @unique
  name           String
  decimalOdds    Decimal        @db.Decimal(18, 6)
  isDisabled     Boolean
  status         String?
  outcomeType    String?
  points         Decimal?       @db.Decimal(18, 6)
  sourceMetadata Json?
  marketId       String         @db.Uuid
  market         Market         @relation(fields: [marketId], references: [id], onDelete: Cascade)
  betSelections  BetSelection[]
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  @@index([marketId])
}

model User {
  id            String            @id @default(uuid()) @db.Uuid
  email         String            @unique
  passwordHash  String
  isActive      Boolean           @default(true)
  balance       Balance?
  bets          Bet[]
  movements     BalanceMovement[]
  notifications Notification[]
  auditEvents   AuditEvent[]
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt
}

model Balance {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @unique @db.Uuid
  amount    Decimal  @db.Decimal(18, 2)
  bonus     Decimal  @default(0) @db.Decimal(18, 2)
  currency  String   @db.Char(3)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Bet {
  id               String            @id @default(uuid()) @db.Uuid
  userId           String            @db.Uuid
  type             BetType
  status           BetStatus
  stake            Decimal           @db.Decimal(18, 2)
  combinedOdds     Decimal           @db.Decimal(18, 6)
  potentialReturns Decimal           @db.Decimal(18, 2)
  currency         String            @db.Char(3)
  idempotencyKey   String
  payloadHash      String
  rejectionCode    String?
  user             User              @relation(fields: [userId], references: [id])
  selections       BetSelection[]
  movements        BalanceMovement[]
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  @@unique([userId, idempotencyKey])
}

model BetSelection {
  id               String    @id @default(uuid()) @db.Uuid
  betId            String    @db.Uuid
  selectionId      String    @db.Uuid
  eventId          String    @db.Uuid
  eventName        String
  marketName       String
  selectionName    String
  acceptedOdds     Decimal   @db.Decimal(18, 6)
  homeTeamName     String?
  awayTeamName     String?
  snapshotMetadata Json?
  bet              Bet       @relation(fields: [betId], references: [id], onDelete: Cascade)
  selection        Selection @relation(fields: [selectionId], references: [id])
  event            Event     @relation(fields: [eventId], references: [id])
  createdAt        DateTime  @default(now())
}

model BalanceMovement {
  id        String       @id @default(uuid()) @db.Uuid
  userId    String       @db.Uuid
  betId     String?      @db.Uuid
  type      MovementType
  amount    Decimal      @db.Decimal(18, 2)
  currency  String       @db.Char(3)
  reference String       @unique
  user      User         @relation(fields: [userId], references: [id])
  bet       Bet?         @relation(fields: [betId], references: [id])
  createdAt DateTime     @default(now())

  @@index([userId, createdAt])
}

model OutboxEvent {
  id           String       @id @default(uuid()) @db.Uuid
  type         String
  aggregateId  String
  payload      Json
  status       OutboxStatus @default(PENDING)
  attempts     Int          @default(0)
  occurredAt   DateTime
  processingAt DateTime?
  publishedAt  DateTime?
  lastError    String?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  @@index([status, occurredAt])
}

model AuditEvent {
  id          String   @id @default(uuid()) @db.Uuid
  externalKey String   @unique
  type        String
  userId      String?  @db.Uuid
  aggregateId String?
  requestId   String?
  payload     Json?
  user        User?    @relation(fields: [userId], references: [id])
  createdAt   DateTime @default(now())

  @@index([type, createdAt])
}

model Notification {
  id          String    @id @default(uuid()) @db.Uuid
  externalKey String    @unique
  userId      String    @db.Uuid
  type        String
  title       String
  message     String
  metadata    Json?
  readAt      DateTime?
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt   DateTime  @default(now())

  @@index([userId, createdAt])
}

        ],
        "tags": ["balance"]
      }
    },
    "/notifications": {
      "get": {
        "operationId": "NotificationsController_list",
        "parameters": [],
        "responses": {
          "200": {
            "description": ""
          }
        },
        "security": [
          {
            "bearer": []
          }
        ],
        "tags": ["notifications"]
      }
    },
    "/notifications/{id}/read": {
      "patch": {
        "operationId": "NotificationsController_read",
        "parameters": [
          {
            "name": "id",
            "required": true,
            "in": "path",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": ""
          }
        },
        "security": [
          {
            "bearer": []
          }
        ],
        "tags": ["notifications"]
      }
    }
  },
  "info": {
    "title": "API Mundial 2026",
    "description": "",
    "version": "1.0.0",
    "contact": {}
  },
  "tags": [],
  "servers": [],
  "components": {
    "securitySchemes": {
      "bearer": {
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "type": "http"
      }
    },
    "schemas": {
      "Object": {
        "type": "object",
        "properties": {}
      },
      "CalculateBetslipDto": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "enum": ["SINGLE", "COMBO"]
          },
          "stake": {
            "type": "string",
            "example": "10.00"
          },
          "selectionIds": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": ["type", "stake", "selectionIds"]
      },
      "LoginDto": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "example": "demo@apuestatotal.test"
          },
          "password": {
            "type": "string",
            "example": "Demo12345!"
          }
        },
        "required": ["email", "password"]
      }
    }
  }
}

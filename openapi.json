    "/events": {
      "get": {
        "description": "Ejemplo rápido: `GET /events?from=2026-06-11T00:00:00Z&to=2026-06-18T23:59:59Z`",
        "operationId": "EventsController_list",
        "parameters": [
          {
            "name": "from",
            "required": false,
            "in": "query",
            "description": "Inicio inclusivo del rango en formato ISO 8601",
            "schema": {
              "example": "2026-06-11T00:00:00Z",
              "type": "string"
            }
          },
          {
            "name": "to",
            "required": false,
            "in": "query",
            "description": "Fin inclusivo del rango en formato ISO 8601",
            "schema": {
              "example": "2026-06-18T23:59:59Z",
              "type": "string"
            }
          },
          {
            "name": "phase",
            "required": false,
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "group",
            "required": false,
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "status",
            "required": false,
            "in": "query",
            "schema": {
              "type": "string",
              "enum": ["SCHEDULED", "LIVE", "FINISHED", "POSTPONED", "CANCELLED", "SUSPENDED"]
            }
          },
          {
            "name": "timezone",
            "required": false,
            "in": "query",
            "schema": {
              "default": "UTC",
              "type": "string"
            }
          },
          {
            "name": "page",
            "required": false,
            "in": "query",
            "schema": {
              "default": 1,
              "allOf": [
                {
                  "$ref": "#/components/schemas/Object"
                }
              ]
            }
          },
          {
            "name": "limit",
            "required": false,
            "in": "query",
            "schema": {
              "maximum": 100,
              "default": 20,
              "allOf": [
                {
                  "$ref": "#/components/schemas/Object"
                }
              ]
            }
          }
        ],
        "responses": {
          "200": {
            "description": ""
          }
        },
        "summary": "Lista eventos por rango",
        "tags": ["events"]
      }
    },
    "/events/{eventId}": {
      "get": {
        "operationId": "EventsController_detail",
        "parameters": [
          {
            "name": "eventId",
            "required": true,
            "in": "path",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": ""
          }
        },
        "summary": "Detalle y mercados de un evento",
        "tags": ["events"]
      }
    },
    "/betslip/calculate": {
      "post": {
        "operationId": "BetslipController_calculate",
        "parameters": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CalculateBetslipDto"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": ""
          }
        },
        "summary": "Calcula un cupón sin generar movimientos",
        "tags": ["betslip"]
      }
    },
    "/betslip/place": {
      "post": {
        "operationId": "BetslipController_place",
        "parameters": [
          {
            "name": "Idempotency-Key",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CalculateBetslipDto"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": ""
          }
        },
        "security": [
          {
            "bearer": []
          }
        ],
        "summary": "Confirma una apuesta con débito atómico",
        "tags": ["betslip"]
      }
    },
    "/auth/login": {
      "post": {
        "operationId": "AuthController_login",
        "parameters": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LoginDto"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": ""
          }
        },
        "summary": "Inicia sesión y entrega un JWT",
        "tags": ["auth"]
      }
    },
    "/balance": {
      "get": {
        "operationId": "BalanceController_get",

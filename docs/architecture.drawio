        <mxCell id="a12" value="5 fallos" style="edgeStyle=orthogonalEdgeStyle;html=1;dashed=1;strokeColor=#b85450;endArrow=block;endFill=1" edge="1" parent="awsGroup" source="auditQ" target="auditDlq"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="a13" value="5 fallos" style="edgeStyle=orthogonalEdgeStyle;html=1;dashed=1;strokeColor=#b85450;endArrow=block;endFill=1" edge="1" parent="awsGroup" source="notificationQ" target="notificationDlq"><mxGeometry relative="1" as="geometry"/></mxCell>

<mxfile host="app.diagrams.net" modified="2026-08-23T00:00:00.000Z" agent="Codex" version="24.7.17" type="device">
  <diagram id="architecture" name="1. Arquitectura AWS SQS">
    <mxGraphModel dx="1422" dy="794" grid="1" gridSize="10" page="1" pageWidth="1600" pageHeight="900">
      <root>
        <mxCell id="0"/><mxCell id="1" parent="0"/>
        <mxCell id="t1" value="API de apuestas — Arquitectura con Amazon SQS" style="text;html=1;align=center;fontSize=24;fontStyle=1" vertex="1" parent="1"><mxGeometry x="410" y="20" width="760" height="40" as="geometry"/></mxCell>
        <mxCell id="client" value="Clientes&#xa;Postman · Swagger · Frontend" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1" vertex="1" parent="1"><mxGeometry x="30" y="150" width="210" height="90" as="geometry"/></mxCell>
        <mxCell id="apiGroup" value="NestJS + Fastify" style="swimlane;html=1;rounded=1;startSize=32;fillColor=#e1d5e7;strokeColor=#9673a6;fontStyle=1" vertex="1" parent="1"><mxGeometry x="300" y="90" width="460" height="360" as="geometry"/></mxCell>
        <mxCell id="api" value="API HTTP&#xa;Auth · Events · Betslip&#xa;Balance · Notifications" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1" vertex="1" parent="apiGroup"><mxGeometry x="30" y="60" width="190" height="100" as="geometry"/></mxCell>
        <mxCell id="domain" value="Dominio puro&#xa;Money · Odds&#xa;BetslipCalculator" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656" vertex="1" parent="apiGroup"><mxGeometry x="250" y="60" width="180" height="100" as="geometry"/></mxCell>
        <mxCell id="outbox" value="Transacción financiera&#xa;Bet + débito + movimiento&#xa;+ OutboxEvent" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1" vertex="1" parent="apiGroup"><mxGeometry x="105" y="220" width="250" height="90" as="geometry"/></mxCell>
        <mxCell id="workerGroup" value="Worker independiente" style="swimlane;html=1;rounded=1;startSize=32;fillColor=#fff2cc;strokeColor=#d6b656;fontStyle=1" vertex="1" parent="1"><mxGeometry x="830" y="90" width="260" height="360" as="geometry"/></mxCell>
        <mxCell id="publisher" value="Outbox Publisher&#xa;Polling + SKIP LOCKED&#xa;SendMessage" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontStyle=1" vertex="1" parent="workerGroup"><mxGeometry x="30" y="60" width="200" height="100" as="geometry"/></mxCell>
        <mxCell id="consumers" value="SQS Consumers&#xa;Long polling&#xa;Upsert idempotente" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontStyle=1" vertex="1" parent="workerGroup"><mxGeometry x="30" y="220" width="200" height="100" as="geometry"/></mxCell>
        <mxCell id="awsGroup" value="AWS (LocalStack en desarrollo)" style="swimlane;html=1;rounded=1;startSize=32;fillColor=#f5f5f5;strokeColor=#666666;fontStyle=1" vertex="1" parent="1"><mxGeometry x="1160" y="90" width="380" height="600" as="geometry"/></mxCell>
        <mxCell id="auditQ" value="Amazon SQS&#xa;audit-events" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontStyle=1" vertex="1" parent="awsGroup"><mxGeometry x="35" y="65" width="135" height="85" as="geometry"/></mxCell>
        <mxCell id="notificationQ" value="Amazon SQS&#xa;notifications" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontStyle=1" vertex="1" parent="awsGroup"><mxGeometry x="205" y="65" width="140" height="85" as="geometry"/></mxCell>
        <mxCell id="auditDlq" value="audit-events-dlq" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450" vertex="1" parent="awsGroup"><mxGeometry x="35" y="230" width="135" height="65" as="geometry"/></mxCell>
        <mxCell id="notificationDlq" value="notifications-dlq" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450" vertex="1" parent="awsGroup"><mxGeometry x="205" y="230" width="140" height="65" as="geometry"/></mxCell>
        <mxCell id="awsNote" value="At-least-once&#xa;Long polling: 10 s&#xa;Visibility timeout: 30 s&#xa;DLQ después de 5 recepciones" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;fillColor=#fff2cc;strokeColor=#d6b656" vertex="1" parent="awsGroup"><mxGeometry x="75" y="370" width="230" height="130" as="geometry"/></mxCell>
        <mxCell id="postgres" value="PostgreSQL&#xa;Fuente de verdad financiera&#xa;Bets · Balance · Movements&#xa;Outbox · Audit · Notifications" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=15;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1" vertex="1" parent="1"><mxGeometry x="330" y="550" width="260" height="150" as="geometry"/></mxCell>
        <mxCell id="redis" value="Redis&#xa;Caché de eventos&#xa;Rate limiting" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=15;fillColor=#f8cecc;strokeColor=#b85450;fontStyle=1" vertex="1" parent="1"><mxGeometry x="650" y="565" width="180" height="120" as="geometry"/></mxCell>
        <mxCell id="a1" value="HTTPS / JSON" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1" edge="1" parent="1" source="client" target="api"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="a2" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1" edge="1" parent="apiGroup" source="api" target="domain"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="a3" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1" edge="1" parent="apiGroup" source="domain" target="outbox"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="a4" value="Prisma / SQL" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1" edge="1" parent="1" source="outbox" target="postgres"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="a5" value="cache / rate limit" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1" edge="1" parent="1" source="api" target="redis"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="a6" value="reclama PENDING" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1" edge="1" parent="1" source="postgres" target="publisher"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="a7" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1" edge="1" parent="1" source="publisher" target="auditQ"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="a8" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1" edge="1" parent="1" source="publisher" target="notificationQ"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="a9" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1" edge="1" parent="1" source="auditQ" target="consumers"><mxGeometry relative="1" as="geometry"/></mxCell>

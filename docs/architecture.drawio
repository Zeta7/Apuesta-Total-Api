  </diagram>
  <diagram id="flow" name="2. Flujo apuesta y SQS">
    <mxGraphModel dx="1422" dy="794" grid="1" gridSize="10" page="1" pageWidth="1600" pageHeight="900">
      <root>
        <mxCell id="f0"/><mxCell id="f1" parent="f0"/>
        <mxCell id="ft" value="Flujo: POST /betslip/place → Outbox → Amazon SQS" style="text;html=1;align=center;fontSize=24;fontStyle=1" vertex="1" parent="f1"><mxGeometry x="400" y="25" width="800" height="40" as="geometry"/></mxCell>
        <mxCell id="fclient" value="1. Cliente&#xa;JWT + Idempotency-Key&#xa;selectionIds + stake" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1" vertex="1" parent="f1"><mxGeometry x="30" y="120" width="210" height="105" as="geometry"/></mxCell>
        <mxCell id="fapi" value="2. API&#xa;Autentica y valida&#xa;Revalida selección y cuota" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontStyle=1" vertex="1" parent="f1"><mxGeometry x="290" y="120" width="220" height="105" as="geometry"/></mxCell>
        <mxCell id="ftx" value="3. Transacción PostgreSQL&#xa;Débito condicional&#xa;Bet + snapshots + movement&#xa;2 OutboxEvent PENDING" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1" vertex="1" parent="f1"><mxGeometry x="560" y="105" width="250" height="135" as="geometry"/></mxCell>
        <mxCell id="fresponse" value="4. HTTP 201&#xa;Apuesta ACCEPTED&#xa;No espera a SQS" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1" vertex="1" parent="f1"><mxGeometry x="860" y="120" width="210" height="105" as="geometry"/></mxCell>
        <mxCell id="fpublisher" value="5. Outbox Publisher&#xa;FOR UPDATE SKIP LOCKED&#xa;PENDING → PROCESSING" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontStyle=1" vertex="1" parent="f1"><mxGeometry x="560" y="340" width="250" height="110" as="geometry"/></mxCell>
        <mxCell id="fsend" value="6. SendMessage&#xa;id + type + payload&#xa;PROCESSING → PUBLISHED" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontStyle=1" vertex="1" parent="f1"><mxGeometry x="860" y="340" width="230" height="110" as="geometry"/></mxCell>
        <mxCell id="fqa" value="7A. SQS audit-events" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontStyle=1" vertex="1" parent="f1"><mxGeometry x="1170" y="300" width="210" height="75" as="geometry"/></mxCell>
        <mxCell id="fqn" value="7B. SQS notifications" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontStyle=1" vertex="1" parent="f1"><mxGeometry x="1170" y="415" width="210" height="75" as="geometry"/></mxCell>
        <mxCell id="fca" value="8A. Consumer auditoría&#xa;Upsert por outboxEvent.id" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontStyle=1" vertex="1" parent="f1"><mxGeometry x="860" y="570" width="230" height="90" as="geometry"/></mxCell>
        <mxCell id="fcn" value="8B. Consumer notificación&#xa;Upsert por outboxEvent.id" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontStyle=1" vertex="1" parent="f1"><mxGeometry x="1170" y="570" width="230" height="90" as="geometry"/></mxCell>
        <mxCell id="fdb" value="9. PostgreSQL&#xa;AuditEvent + Notification&#xa;sin duplicados" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=15;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1" vertex="1" parent="f1"><mxGeometry x="995" y="735" width="260" height="120" as="geometry"/></mxCell>
        <mxCell id="ffail" value="Si SQS falla:&#xa;Outbox vuelve a PENDING.&#xa;La apuesta confirmada no se revierte." style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;fillColor=#fff2cc;strokeColor=#d6b656" vertex="1" parent="f1"><mxGeometry x="285" y="350" width="210" height="115" as="geometry"/></mxCell>
        <mxCell id="fretry" value="Si el consumo falla:&#xa;visibility timeout → reintento&#xa;5 recepciones → DLQ" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;fillColor=#f8cecc;strokeColor=#b85450" vertex="1" parent="f1"><mxGeometry x="1430" y="355" width="140" height="145" as="geometry"/></mxCell>
        <mxCell id="fe1" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1" edge="1" parent="f1" source="fclient" target="fapi"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="fe2" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1" edge="1" parent="f1" source="fapi" target="ftx"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="fe3" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1" edge="1" parent="f1" source="ftx" target="fresponse"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="fe4" value="polling" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1" edge="1" parent="f1" source="ftx" target="fpublisher"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="fe5" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1" edge="1" parent="f1" source="fpublisher" target="fsend"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="fe6" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1" edge="1" parent="f1" source="fsend" target="fqa"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="fe7" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1" edge="1" parent="f1" source="fsend" target="fqn"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="fe8" value="long polling" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1" edge="1" parent="f1" source="fqa" target="fca"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="fe9" value="long polling" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1" edge="1" parent="f1" source="fqn" target="fcn"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="fe10" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1" edge="1" parent="f1" source="fca" target="fdb"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="fe11" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1" edge="1" parent="f1" source="fcn" target="fdb"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="fe12" style="edgeStyle=orthogonalEdgeStyle;html=1;dashed=1;strokeColor=#d6b656;endArrow=block;endFill=1" edge="1" parent="f1" source="fpublisher" target="ffail"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="fe13" style="edgeStyle=orthogonalEdgeStyle;html=1;dashed=1;strokeColor=#b85450;endArrow=block;endFill=1" edge="1" parent="f1" source="fqn" target="fretry"><mxGeometry relative="1" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="decisions" name="3. Decisiones de arquitectura">
    <mxGraphModel dx="1422" dy="794" grid="1" gridSize="10" page="1" pageWidth="1600" pageHeight="900">
      <root>
        <mxCell id="d0"/><mxCell id="d1" parent="d0"/>
        <mxCell id="dt" value="Decisiones de arquitectura y trade-offs" style="text;html=1;align=center;fontSize=24;fontStyle=1" vertex="1" parent="d1"><mxGeometry x="410" y="25" width="760" height="40" as="geometry"/></mxCell>
        <mxCell id="dp" value="Persistencia: PostgreSQL" style="swimlane;html=1;rounded=1;startSize=38;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;fontSize=16" vertex="1" parent="d1"><mxGeometry x="50" y="100" width="460" height="300" as="geometry"/></mxCell>
        <mxCell id="dpt" value="• Fuente única de verdad financiera.&#xa;• Transacciones ACID para apuesta, débito, movimiento y Outbox.&#xa;• Prisma para acceso tipado y migraciones.&#xa;• Decimal para dinero y cuotas; nunca float.&#xa;• Redis no almacena saldo ni apuestas." style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=15;spacing=12" vertex="1" parent="dp"><mxGeometry x="20" y="60" width="420" height="210" as="geometry"/></mxCell>
        <mxCell id="dc" value="Concurrencia e idempotencia" style="swimlane;html=1;rounded=1;startSize=38;fillColor=#fff2cc;strokeColor=#d6b656;fontStyle=1;fontSize=16" vertex="1" parent="d1"><mxGeometry x="570" y="100" width="460" height="300" as="geometry"/></mxCell>
        <mxCell id="dct" value="• Débito atómico: UPDATE Balance ... WHERE amount &gt;= stake.&#xa;• Solo una operación gana cuando compiten por el mismo saldo.&#xa;• userId + Idempotency-Key es único.&#xa;• Hash canónico detecta reutilización con otro payload.&#xa;• FOR UPDATE SKIP LOCKED permite varios publishers Outbox." style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=15;spacing=12" vertex="1" parent="dc"><mxGeometry x="20" y="60" width="420" height="210" as="geometry"/></mxCell>
        <mxCell id="dq" value="Mensajería: Amazon SQS" style="swimlane;html=1;rounded=1;startSize=38;fillColor=#e1d5e7;strokeColor=#9673a6;fontStyle=1;fontSize=16" vertex="1" parent="d1"><mxGeometry x="1090" y="100" width="460" height="300" as="geometry"/></mxCell>
        <mxCell id="dqt" value="• Desacopla confirmación de auditoría/notificación.&#xa;• Patrón Outbox evita perder mensajes tras confirmar una apuesta.&#xa;• Entrega at-least-once; consumidores idempotentes por eventId.&#xa;• Long polling reduce solicitudes vacías y costo.&#xa;• DLQ conserva mensajes venenosos tras 5 recepciones." style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=15;spacing=12" vertex="1" parent="dq"><mxGeometry x="20" y="60" width="420" height="210" as="geometry"/></mxCell>
        <mxCell id="dr" value="Redis" style="swimlane;html=1;rounded=1;startSize=38;fillColor=#f8cecc;strokeColor=#b85450;fontStyle=1;fontSize=16" vertex="1" parent="d1"><mxGeometry x="50" y="460" width="460" height="240" as="geometry"/></mxCell>
        <mxCell id="drt" value="• Caché de consultas de eventos con TTL.&#xa;• Rate limiting distribuido.&#xa;• Fallo de caché degrada hacia PostgreSQL.&#xa;• Ya no se usa BullMQ: SQS es la cola." style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=15;spacing=12" vertex="1" parent="dr"><mxGeometry x="20" y="60" width="420" height="150" as="geometry"/></mxCell>
        <mxCell id="de" value="Servicios externos / cloud" style="swimlane;html=1;rounded=1;startSize=38;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;fontSize=16" vertex="1" parent="d1"><mxGeometry x="570" y="460" width="460" height="240" as="geometry"/></mxCell>
        <mxCell id="det" value="• Producción: Amazon SQS y credenciales por IAM Role.&#xa;• Desarrollo: LocalStack reproduce la API de SQS.&#xa;• Configuración por URLs de cola y región AWS.&#xa;• Permisos mínimos: Send, Receive, Delete y GetAttributes." style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=15;spacing=12" vertex="1" parent="de"><mxGeometry x="20" y="60" width="420" height="150" as="geometry"/></mxCell>
        <mxCell id="dtrade" value="Trade-offs aceptados" style="swimlane;html=1;rounded=1;startSize=38;fillColor=#f5f5f5;strokeColor=#666666;fontStyle=1;fontSize=16" vertex="1" parent="d1"><mxGeometry x="1090" y="460" width="460" height="240" as="geometry"/></mxCell>
        <mxCell id="dtradet" value="• Consistencia eventual en auditoría y notificaciones.&#xa;• Posibles duplicados de SQS neutralizados por upsert.&#xa;• El polling Outbox agrega latencia pequeña y configurable.&#xa;• Monolito modular reduce complejidad operativa del reto." style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=15;spacing=12" vertex="1" parent="dtrade"><mxGeometry x="20" y="60" width="420" height="150" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
